# Database
# Local: leave this as localhost — the app uses an embedded Postgres file in data/pglite
# Production: paste your Neon/Vercel URL (must not be localhost)
DATABASE_URL=postgres://mawadda:mawadda@localhost:5432/mawadda

# Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Encrypts wali contact fields at rest — generate another secret
CONTACT_ENCRYPTION_KEY=replace-with-another-long-random-secret

# SMS OTP + match-release texts (optional in local dev; codes print to the terminal)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email verification (optional in local dev; links print to the terminal)
RESEND_API_KEY=
EMAIL_FROM=Ulfah <noreply@localhost>
